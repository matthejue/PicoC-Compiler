#!/system/bin/sh

set -eu

case "$0" in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac
install_root=$(CDPATH= cd "$script_dir" && pwd)

export PICOC_COMPILER_ROOT="$install_root"
export LD_LIBRARY_PATH="$install_root/runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$install_root/libexec/picoc_compiler" "$@"
