int (*get_values(int (*values)[3]))[3] {
  return values;
}

int add(int left, int right) {
  return left + right;
}

int sub(int left, int right) {
  return left - right;
}

int (*get_operation(int use_sub))(int, int) {
  if (use_sub) {
    return sub;
  }

  return add;
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int values[3] = {1, __picoc_input_0, 7};
  int (*returned_values)[3];
