// in:
// expected: 4 42
// dependencies: ../../Pico-OS/lib/stdio/libstdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

struct stt {int len; int *ar;};

int ar[6] = {314, 42, 4, 42, -2, 5};

struct stt st_ar = {.len=6, .ar=ar};

int call_by_reference(int *x, int *y) {
  printf(" %d", *x);
  printf(" %d", *y);
}

void main() {
  call_by_reference(&st_ar.ar[2], &st_ar.ar[3]);
}
