// in:8 6
// expected:42 42

#include "./include/simple_malloc_only_malloc.h"

int main() {
    init_heap();

    int *a = (int *)simple_malloc(input());
    a[0] = 42;

    int *b = (int *)simple_malloc(input());
    b[0] = 21;
    b[1] = 2;

    print(a[0]);
    print(b[0] * b[1]);

    return 0;
}
