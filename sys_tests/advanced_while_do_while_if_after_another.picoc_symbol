if_else_after.5:
  // While(Atom(Name('i'), Lt(), Num('2')), [Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.4'))
condition_check.4:
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Lt(), 
      Num('2')), 
    [
