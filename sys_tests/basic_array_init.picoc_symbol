_global_inits:
main:
  StackMalloc('15')
  Debug()
  Assign(Stackframe(Num('2')), Array([BinOp(Num('0'), Add(), Num('1')), Num('2'), Call(Name('input'), [])], Empty()))
  Debug()
  Assign(Stackframe(Num('8')), Array([Array([Num('1'), BinOp(Num('1'), Add(), Num('1'))], Empty()), Array([Num('3'), Num('4')], Empty()), Array([Call(Name('input'), []), BinOp(Num('3'), Add(), Num('3'))], Empty())], Empty()))
  Debug()
  Assign(Stackframe(Num('14')), Array([Array([Array([Num('1'), Call(Name('input'), []), Num('3')], Empty()), Array([Num('4'), BinOp(Num('2'), Add(), Num('5')), Num('6')], Empty())], Empty())], Empty()))
  Debug()
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2')), Num('2'))]))
  Debug()
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('8')), Num('2')), Num('0'))]))
  Debug()
  Exp(Call(Name('print'), [Deref(Deref(Deref(Stackframe(Num('14')), Num('0')), Num('0')), Num('1'))]))
  Return(Empty())