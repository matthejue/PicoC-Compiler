// in:1 45 8 12
// expected:1 45 8 12 78 5

struct str {int attr1; char attr2[3];};

void main() {
  int attr2_first = input();
  int attr1_second = input();
  int attr2_third = input();
  int attr2_fourth = input();
  struct str ar[2][2] = {{{.attr1=12, .attr2={attr2_first, 2, 3}}, {.attr1=attr1_second, .attr2={4, 5, 6}}}, {{.attr1=78, .attr2={7, attr2_third, 9}}, {.attr1=1011, .attr2={10, 11, attr2_fourth}}}};
  print(ar[0][0].attr2[0]);
  print(ar[0][1].attr1);
  print(ar[1][0].attr2[1]);
  print(ar[1][1].attr2[2]);
  print(ar[1][0].attr1);
  print(ar[0][1].attr2[1]);
}
