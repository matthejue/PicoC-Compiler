_global_inits:
compute:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('x'), 'param'), Empty())
  Return(BinOp(Stackframe(Num('0'), IntType()), Mul(), Num('2')))
main:
  StackMalloc('3')
  Exp(Alloc(Writeable(), IntType(), Name('i'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('sum'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('value'), 'local_var'), Empty())
  Assign(Stackframe(Num('0'), IntType()), Num('0'))
  Assign(Stackframe(Num('1'), IntType()), Num('0'))
  // While(Atom(Name('i'), Lt(), Num('8')), [Assign(Name('value'), BinOp(BinOp(Name('i'), Mul(), Num('3')), Add(), BinOp(Name('i'), Mul(), Num('2')))), Assign(Name('sum'), BinOp(Name('sum'), Add(), Call(Name('compute'), [Name('value')]))), Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.3'))
condition_check.3:
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Lt(), 
      Num('8')), 
    [
      GoTo(Name('while_branch.2'))
    ], 
    [
      GoTo(Name('while_after.1'))
    ])
while_branch.2:
  Assign(Stackframe(Num('2'), IntType()), BinOp(BinOp(Stackframe(Num('0'), IntType()), Mul(), Num('3')), Add(), BinOp(Stackframe(Num('0'), IntType()), Mul(), Num('2'))))
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('1'), IntType()), Add(), Call(Name('compute'), [Stackframe(Num('2'), IntType())])))
  Assign(Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.3'))
while_after.1:
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('1'), IntType()), Mul(), Stackframe(Num('1'), IntType())))
  Return(Num('0'))