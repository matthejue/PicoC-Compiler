// in:3 5 2
// expected:3 5 2

void main() {
  // 1 dim array
  debug;
  int ar1[3] = {0+1, 2, input()};
  // 2 dim array
  debug;
  int ar2[3][2] = {{1, 1+1}, {3, 4}, {input(), 3+3}};
  // 3 dim array
  debug;
  int ar3[1][2][3] = {{{1, input(), 3}, {4, 2+5, 6}}};

  debug;
  print(ar1[2]);
  debug;
  print(ar2[2][0]);
  debug;
  print(ar3[0][0][1]);
}
