// in:3 5 2
// expected: 3 5 2
// dependencies: ../../Pico-OS/lib/stdio/libstdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

void main() {
  // 1 dim array
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int ar1[3] = {0+1, 2, __picoc_input_0};
  // 2 dim array
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int ar2[3][2] = {{1, 1+1}, {3, 4}, {__picoc_input_1, 3+3}};
  // 3 dim array
  int __picoc_input_2;
  scanf(" %d", &__picoc_input_2);
  int ar3[1][2][3] = {{{1, __picoc_input_2, 3}, {4, 2+5, 6}}};

  printf(" %d", ar1[2]);
  printf(" %d", ar2[2][0]);
  printf(" %d", ar3[0][0][1]);
}
