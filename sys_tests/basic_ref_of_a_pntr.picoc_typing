_global_inits:
main:
  StackMalloc('3')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('1'), PntrDecl(IntType())), Ref(Stackframe(Num('0'), IntType()), IntType()))
  Assign(Stackframe(Num('2'), PntrDecl(PntrDecl(IntType()))), Ref(Stackframe(Num('1'), PntrDecl(IntType())), PntrDecl(IntType())))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('2'), PntrDecl(PntrDecl(IntType()))), Num('0'), PntrDecl(PntrDecl(IntType()))), Num('0'), PntrDecl(IntType()))]), Empty())
  Return(Empty())