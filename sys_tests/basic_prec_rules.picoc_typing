_global_inits:
main:
  StackMalloc('4')
  Assign(Stackframe(Num('0'), IntType()), BinOp(BinOp(Num('12'), Mul(), Num('3')), Add(), Num('6')))
  Assign(Stackframe(Num('1'), IntType()), BinOp(BinOp(Num('12'), Mul(), Num('3')), Mul(), Num('6')))
  Assign(Stackframe(Num('2'), IntType()), BinOp(Num('6'), Add(), BinOp(Num('12'), Mul(), Num('3'))))
  Assign(Stackframe(Num('3'), IntType()), BinOp(BinOp(Num('6'), Mul(), Num('12')), Mul(), Num('3')))
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('2'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('3'), IntType())]), Empty())
  Return(Empty())