#include "../../Pico-OS/lib/stdio/stdio.header"

int log2(int a) {
    int b = -1;
    while (a > 0) {
        b = b + 1;
        a = a / 2;
    }
    return b;
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  printf(" %d", log2(__picoc_input_0));
}
