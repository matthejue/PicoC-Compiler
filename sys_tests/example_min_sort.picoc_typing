_global_inits:
min_sort:
  StackMalloc('5')
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('ar'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('len'), 'param'), Empty())
  Assign(Stackframe(Num('2'), IntType()), Num('0'))
  Exp(Alloc(Writeable(), IntType(), Name('j'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('minimum'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('minimum_index'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('tmp'), 'local_var'), Empty())
  // While(Atom(Name('i'), Lt(), Name('len')), [Assign(Name('minimum'), Deref(Name('ar'), Name('i'), Empty())), Assign(Name('minimum_index'), Name('i')), Assign(Name('j'), BinOp(Name('i'), Add(), Num('1'))), While(Atom(Name('j'), Lt(), Name('len')), [If(Atom(Deref(Name('ar'), Name('j'), Empty()), Lt(), Name('minimum')), [Assign(Name('minimum'), Deref(Name('ar'), Name('j'), Empty())), Assign(Name('minimum_index'), Name('j'))]), Assign(Name('j'), BinOp(Name('j'), Add(), Num('1')))]), Assign(Name('tmp'), Deref(Name('ar'), Name('i'), Empty())), Assign(Deref(Name('ar'), Name('i'), Empty()), Deref(Name('ar'), Name('minimum_index'), Empty())), Assign(Deref(Name('ar'), Name('minimum_index'), Empty()), Name('tmp')), Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.7'))
condition_check.7:
  IfElse(
    Atom(
      Stackframe(
        Num('2'), 
        IntType()), 
      Lt(), 
      Stackframe(
        Num('1'), 
        IntType())), 
    [
      GoTo(Name('while_branch.6'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.6:
  Assign(Stackframe(Num('4'), IntType()), Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('2'), IntType()), PntrDecl(IntType())))
  Assign(Stackframe(Num('5'), IntType()), Stackframe(Num('2'), IntType()))
  Assign(Stackframe(Num('3'), IntType()), BinOp(Stackframe(Num('2'), IntType()), Add(), Num('1')))
  // While(Atom(Name('j'), Lt(), Name('len')), [If(Atom(Deref(Name('ar'), Name('j'), Empty()), Lt(), Name('minimum')), [Assign(Name('minimum'), Deref(Name('ar'), Name('j'), Empty())), Assign(Name('minimum_index'), Name('j'))]), Assign(Name('j'), BinOp(Name('j'), Add(), Num('1')))])
  GoTo(Name('condition_check.5'))
condition_check.5:
  IfElse(
    Atom(
      Stackframe(
        Num('3'), 
        IntType()), 
      Lt(), 
      Stackframe(
        Num('1'), 
        IntType())), 
    [
      GoTo(Name('while_branch.4'))
    ], 
    [
      GoTo(Name('while_after.1'))
    ])
while_branch.4:
  // If(Atom(Deref(Name('ar'), Name('j'), Empty()), Lt(), Name('minimum')), [Assign(Name('minimum'), Deref(Name('ar'), Name('j'), Empty())), Assign(Name('minimum_index'), Name('j'))]), 
  IfElse(
    Atom(
      Deref(
        Stackframe(
          Num('0'), 
          PntrDecl(
            IntType())), 
        Stackframe(
          Num('3'), 
          IntType()), 
        PntrDecl(
          IntType())), 
      Lt(), 
      Stackframe(
        Num('4'), 
        IntType())), 
    [
      GoTo(Name('if.3'))
    ], 
    [
      GoTo(Name('if_else_after.2'))
    ])
if.3:
  Assign(Stackframe(Num('4'), IntType()), Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('3'), IntType()), PntrDecl(IntType())))
  Assign(Stackframe(Num('5'), IntType()), Stackframe(Num('3'), IntType()))
  GoTo(Name('if_else_after.2'))
if_else_after.2:
  Assign(Stackframe(Num('3'), IntType()), BinOp(Stackframe(Num('3'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.5'))
while_after.1:
  Assign(Stackframe(Num('6'), IntType()), Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('2'), IntType()), PntrDecl(IntType())))
  Assign(Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('2'), IntType()), PntrDecl(IntType())), Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('5'), IntType()), PntrDecl(IntType())))
  Assign(Deref(Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('5'), IntType()), PntrDecl(IntType())), Stackframe(Num('6'), IntType()))
  Assign(Stackframe(Num('2'), IntType()), BinOp(Stackframe(Num('2'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.7'))
while_after.0:
  Return(Empty())
main:
  StackMalloc('7')
  Assign(Stackframe(Num('0'), IntType()), Num('6'))
  Assign(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Array([Num('314'), Num('42'), Num('4'), Num('42'), Num('-2'), Num('5')], Empty()))
  Exp(Call(Name('min_sort'), [Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Stackframe(Num('0'), IntType())]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('0'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('1'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('2'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('3'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('4'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('6'), ArrayDecl(Num('6'), IntType())), Num('5'), ArrayDecl(Num('6'), IntType()))]), Empty())
  Return(Empty())