_global_inits:
  Assign(Global(Name('heap_space'), StructSpec(Name('point'))), Struct([Assign(Name('x'), Num('0')), Assign(Name('y'), Num('0'))], Empty()))
main:
  StackMalloc('5')
  Exp(Alloc(Writeable(), PntrDecl(StructSpec(Name('point'))), Name('p1'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(StructSpec(Name('point'))), Name('p3'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('a'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), StructSpec(Name('point')), Name('p2'), 'local_var'), Empty())
  Assign(Stackframe(Num('2'), PntrDecl(IntType())), Ref(Attr(Stackframe(Num('4'), StructSpec(Name('point'))), Name('x'), StructSpec(Name('point'))), IntType()))
  Assign(Attr(Stackframe(Num('4'), StructSpec(Name('point'))), Name('x'), StructSpec(Name('point'))), Call(Name('input'), []))
  Assign(Attr(Stackframe(Num('4'), StructSpec(Name('point'))), Name('y'), StructSpec(Name('point'))), Call(Name('input'), []))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2'), PntrDecl(IntType())), Num('1'), PntrDecl(IntType()))]), Empty())
  Assign(Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))), Ref(Global(Name('heap_space'), StructSpec(Name('point'))), StructSpec(Name('point'))))
  Assign(Attr(Deref(Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('y'), StructSpec(Name('point'))), Deref(Stackframe(Num('2'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType())))
  Exp(Call(Name('print'), [Attr(Global(Name('heap_space'), StructSpec(Name('point'))), Name('y'), StructSpec(Name('point')))]), Empty())
  Assign(Stackframe(Num('1'), PntrDecl(StructSpec(Name('point')))), Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))))
  Exp(Call(Name('print'), [Attr(Deref(Stackframe(Num('1'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('y'), StructSpec(Name('point')))]), Empty())
  Assign(Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))), Ref(Stackframe(Num('4'), StructSpec(Name('point'))), StructSpec(Name('point'))))
  Exp(Call(Name('print'), [Attr(Deref(Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('x'), StructSpec(Name('point')))]), Empty())
  Exp(Call(Name('print'), [Attr(Deref(Stackframe(Num('0'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('y'), StructSpec(Name('point')))]), Empty())
  // Exp(Call(Name('print'), [Num('1')]), Empty()), 
  IfElse(
    Atom(
      Attr(
        Deref(
          Stackframe(
            Num('0'), 
            PntrDecl(
              StructSpec(
                Name('point')))), 
          Num('0'), 
          PntrDecl(
            StructSpec(
              Name('point')))), 
        Name('y'), 
        StructSpec(
          Name('point'))), 
      Gt(), 
      Num('5')), 
    [
      GoTo(Name('if.2'))
    ], 
    [
      GoTo(Name('else.1'))
    ])
if.2:
  Exp(Call(Name('print'), [Num('1')]), Empty())
  Assign(Deref(Stackframe(Num('2'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType())), Num('42'))
  GoTo(Name('if_else_after.0'))
else.1:
  Exp(Call(Name('print'), [Num('2')]), Empty())
  Assign(Deref(Stackframe(Num('2'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType())), Num('1'))
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Exp(Call(Name('print'), [Attr(Stackframe(Num('4'), StructSpec(Name('point'))), Name('x'), StructSpec(Name('point')))]), Empty())
  Assign(Attr(Deref(Stackframe(Num('1'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('x'), StructSpec(Name('point'))), Num('0'))
  Assign(Attr(Deref(Stackframe(Num('1'), PntrDecl(StructSpec(Name('point')))), Num('0'), PntrDecl(StructSpec(Name('point')))), Name('y'), StructSpec(Name('point'))), Num('0'))
  Exp(Call(Name('print'), [Attr(Global(Name('heap_space'), StructSpec(Name('point'))), Name('x'), StructSpec(Name('point')))]), Empty())
  Exp(Call(Name('print'), [Attr(Global(Name('heap_space'), StructSpec(Name('point'))), Name('y'), StructSpec(Name('point')))]), Empty())
  Return(Empty())