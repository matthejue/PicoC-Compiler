// expected: 7 4 7 7 7 4 2 1 0 0
// from the Operating Systems Lecture by Prof. Dr. Christoph Scholl
// dependencies: ../../Pico-OS/lib/stdio/libstdio.reti_blocks
#include "../../Pico-OS/lib/stdio/stdio.header"

struct point {
  int x;
  int y;
};

struct point heap_space = {.x=0, .y=0};

void main() {
  // Annahme Symboltabelleneintrag st(p1) = (var, struct point*, 8)
  struct point *p1;
  // Annahme Symboltabelleneintrag st(p3) = (var, struct point*, 9)
  struct point *p3;
  // Annahme Symboltabelleneintrag st(a) = (var, int*, 10)
  int* a;

  //Annahme Symboltabelleneintrag:
  //st(p2) = (struct, x -> (int,0), y -> (int,1), 15)
  struct point p2;
  a = &(p2.x);
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  p2.x = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  p2.y = __picoc_input_1;
  printf(" %d", *a);
  printf(" %d", *(a+1));

  /*** MARKE 1 ***/

  //Annahme: reserviert zusammenhaengenden Bereich auf dem Heap ab Adresse 33
  // p1 = (struct point *) malloc(sizeof(struct point));
  p1 = &heap_space;
  (*p1).y = *a;
  printf(" %d", heap_space.y);
  p3 = p1;
  printf(" %d", (*p3).y);
  p1 = &p2;
  printf(" %d", (*p1).x);
  printf(" %d", (*p1).y);

  /*** MARKE 2 ***/

  if((*p1).y > 5) {
    printf(" %d", 1);
    *a = 42;
  } else {
    printf(" %d", 2);
    *a = 1;
  }
  printf(" %d", p2.x);

  /*** MARKE 3 ***/

  // free(p3);
  (*p3).x = 0;
  (*p3).y = 0;
  printf(" %d", heap_space.x);
  printf(" %d", heap_space.y);
}
