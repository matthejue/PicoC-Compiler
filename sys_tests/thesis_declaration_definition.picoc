// dependencies: ../../Pico-OS/lib/stdio/libstdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

void fun_declared_before(int *param);

int fun_defined(int param) {
  return param + 10;
}

void main() {
  int res = fun_defined(22);
  fun_declared_before(&res);
  printf(" %d", res);
}

void fun_declared_before(int *param) {
  *param = *param + 10;
}
