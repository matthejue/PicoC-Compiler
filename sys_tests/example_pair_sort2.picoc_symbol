_global_inits:
  Exp(Alloc(Writeable(), IntType(), Name('b'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('x'), 'local_var'), Empty())
ps:
  StackMalloc('2')
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('x'), 'param'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('y'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('h'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('getauscht'), 'local_var'), Empty())
  Assign(Stackframe(Num('3'), IntType()), Num('0'))
  // If(Atom(Deref(Name('x'), Num('0'), Empty()), Gt(), Deref(Name('y'), Num('0'), Empty())), [Assign(Name('h'), Deref(Name('x'), Num('0'), Empty())), Assign(Deref(Name('x'), Num('0'), Empty()), Deref(Name('y'), Num('0'), Empty())), Assign(Deref(Name('y'), Num('0'), Empty()), Name('h')), Assign(Name('getauscht'), Num('1'))]), 
  IfElse(
    Atom(
      Deref(
        Stackframe(
          Num('0'), 
          PntrDecl(
            IntType())), 
        Num('0'), 
        Empty()), 
      Gt(), 
      Deref(
        Stackframe(
          Num('1'), 
          PntrDecl(
            IntType())), 
        Num('0'), 
        Empty())), 
    [
      GoTo(Name('if.1'))
    ], 
    [
      GoTo(Name('if_else_after.0'))
    ])
if.1:
  Assign(Stackframe(Num('2'), IntType()), Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty()))
  Assign(Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty()), Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('0'), Empty()))
  Assign(Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('0'), Empty()), Stackframe(Num('2'), IntType()))
  Assign(Stackframe(Num('3'), IntType()), Num('1'))
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Return(Stackframe(Num('3'), IntType()))
main:
  StackMalloc('2')
  Exp(Alloc(Writeable(), IntType(), Name('b'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('res'), 'local_var'), Empty())
  Assign(Global(Name('x'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Exp(Call(Name('print'), [Global(Name('x'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Assign(Stackframe(Num('1'), IntType()), Call(Name('ps'), [Ref(Global(Name('x'), IntType()), Empty()), Ref(Stackframe(Num('0'), IntType()), Empty())]))
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Exp(Call(Name('print'), [Global(Name('x'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Return(Empty())