translation_unit: struct stt {int len; int *ar;};\n\nvoid min_sort(int *ar, int len) {\n  int i = 0;\n  int j;\n  int minimum;\n  int minimum_index;\n  int tmp;\n  while (i < len) {\n    minimum = ar[i];\n    minimum_index = i;\n    j = i + 1;\n    while (j < len) {\n      if (ar[j] < minimum) {\n        minimum = ar[j];\n        minimum_index = j;\n      }\n      j = j + 1;\n    }\n    tmp = ar[i];\n    ar[i] = ar[minimum_index];\n    ar[minimum_index] = tmp;\n    i = i + 1;\n  }\n}\n\nvoid main() {\n  int len = 6;\n  int ar[6] = {314, 42, 4, 42, -2, 5};\n  min_sort(ar, len);\n  print(ar[0]);\n  print(ar[1]);\n  print(ar[2]);\n  print(ar[3]);\n  print(ar[4]);\n  print(ar[5]);\n}\n
