// in:2 10
// expected: 1024
// from the Introduction to Programming Lecture by Peter Thiemann
// dependencies: ../../Pico-OS/lib/stdio/libstdio.reti_blocks
#include "../../Pico-OS/lib/stdio/stdio.header"

int fast_efficient_iterative(int a, int n, int acc) {
  int tmp;
  while (n != 0) {
    if (n % 2 == 0) {
      a = a * a;
      n = n / 2;
    } else {
      tmp = a;
      a = a * a;
      n = n / 2;
      acc = acc * tmp;
    }
  }
  return acc;
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int a = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int n = __picoc_input_1;
  printf(" %d", fast_efficient_iterative(a, n, 1));
}
