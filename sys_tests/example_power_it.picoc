#include "../../Pico-OS/lib/stdio/stdio.header"


int power_iterative(int a, int n, int acc) {
    while (n != 0) {
        n = n - 1;
        acc = acc * a;
    }
    return acc;
}


void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int a = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int n = __picoc_input_1;
  printf(" %d", power_iterative(a, n, 1));
}
