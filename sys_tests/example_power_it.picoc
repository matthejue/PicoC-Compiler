// in:2 11
// expected:2048
// from the Introduction to Programming Lecture by Peter Thiemann


int power_iterative(int a, int n, int acc) {
    while (n != 0) {
        n = n - 1;
        acc = acc * a;
    }
    return acc;
}


void main() {
  int a = input();
  int n = input();
  print(power_iterative(a, n, 1));
}
