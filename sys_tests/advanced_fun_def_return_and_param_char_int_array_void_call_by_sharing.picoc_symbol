_global_inits:
main:
  StackMalloc('3')
  Assign(Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Array([Num('1'), Num('2'), Num('3')], Empty()))
  Exp(Call(Name('print_all'), [Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Num('3')]), Empty())
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Num('2'), Empty())]), Empty())
  Return(Empty())
print_all:
  StackMalloc('1')
  Exp(Alloc(Writeable(), ArrayDecl(Num('3'), IntType()), Name('ar_ref'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('len'), 'param'), Empty())
  Assign(Stackframe(Num('4'), IntType()), Num('0'))
  // While(Atom(Name('i'), Lt(), Name('len')), [Exp(Call(Name('print'), [Deref(Name('ar_ref'), Name('i'), Empty())]), Empty()), Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.3'))
condition_check.3:
  IfElse(
    Atom(
      Stackframe(
        Num('4'), 
        IntType()), 
      Lt(), 
      Stackframe(
        Num('3'), 
        IntType())), 
    [
      GoTo(Name('while_branch.2'))
    ], 
    [
      GoTo(Name('while_after.1'))
    ])
while_branch.2:
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Stackframe(Num('4'), IntType()), Empty())]), Empty())
  Assign(Stackframe(Num('4'), IntType()), BinOp(Stackframe(Num('4'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.3'))
while_after.1:
  Assign(Deref(Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Num('2'), Empty()), Call(Name('input'), []))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('2'), ArrayDecl(Num('3'), IntType())), Num('2'), Empty())]), Empty())
  Return(Num('1'))