_global_inits:
power_iterative:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('a'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('n'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('acc'), 'param'), Empty())
  // While(Atom(Name('n'), NEq(), Num('0')), [Assign(Name('n'), BinOp(Name('n'), Sub(), Num('1'))), Assign(Name('acc'), BinOp(Name('acc'), Mul(), Name('a')))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('1'), 
        IntType()), 
      NEq(), 
      Num('0')), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('1'), IntType()), Sub(), Num('1')))
  Assign(Stackframe(Num('2'), IntType()), BinOp(Stackframe(Num('2'), IntType()), Mul(), Stackframe(Num('0'), IntType())))
  GoTo(Name('condition_check.2'))
while_after.0:
  Return(Stackframe(Num('2'), IntType()))
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('power_iterative'), [Call(Name('input'), []), Call(Name('input'), []), Num('1')])]), Empty())
  Return(Empty())