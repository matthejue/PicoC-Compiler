// expected: 512
// from the Introduction to Programming Lecture by Peter Thiemann
// dependencies: ../../Pico-OS/lib/stdio/libstdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

int power_efficient(int a, int n) {
  if (n == 0) {
    return 1;
  } else if (n % 2 == 0) {
    return power_efficient(a * a, n / 2);
  } else {
    return a * power_efficient(a * a, n / 2);
  }
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int a = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int n = __picoc_input_1;
  printf(" %d", power_efficient(a, n));
}
