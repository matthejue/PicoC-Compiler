_global_inits:
  Assign(Global(Name('ar'), ArrayDecl(Num('11'), IntType())), Array([Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0'), Num('0')], Empty()))
fib_efficient:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('n'), 'param'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('res'), 'param'), Empty())
  // Return(Num('0')), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Eq(), 
      Num('0')), 
    [
      GoTo(Name('if.4'))
    ], 
    [
      GoTo(Name('else.3'))
    ])
if.4:
  Return(Num('0'))
else.3:
  // If(Atom(Name('n'), Eq(), Num('1')), [Assign(Deref(Name('res'), Num('0'), Empty()), Num('0')), Assign(Deref(Name('res'), Num('1'), Empty()), Num('1')), Return(Num('1'))]), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Eq(), 
      Num('1')), 
    [
      GoTo(Name('if.2'))
    ], 
    [
      GoTo(Name('if_else_after.1'))
    ])
if.2:
  Assign(Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType())), Num('0'))
  Assign(Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('1'), PntrDecl(IntType())), Num('1'))
  Return(Num('1'))
if_else_after.1:
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Assign(Deref(Stackframe(Num('1'), PntrDecl(IntType())), Stackframe(Num('0'), IntType()), PntrDecl(IntType())), BinOp(Call(Name('fib_efficient'), [BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('1')), Stackframe(Num('1'), PntrDecl(IntType()))]), Add(), Deref(Stackframe(Num('1'), PntrDecl(IntType())), BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('2')), PntrDecl(IntType()))))
  Return(Deref(Stackframe(Num('1'), PntrDecl(IntType())), Stackframe(Num('0'), IntType()), PntrDecl(IntType())))
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('fib_efficient'), [Call(Name('input'), []), Global(Name('ar'), ArrayDecl(Num('11'), IntType()))])]), Empty())
  Return(Empty())