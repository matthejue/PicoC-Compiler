// in:
// expected: 24
// based on a example program from Christoph Scholl's Operating Systems lecture
// dependencies: ../../Pico-OS/lib/stdio/libstdio.reti_blocks
#include "../../Pico-OS/lib/stdio/stdio.header"

int faculty(int n){
  int res = 1;
  while (1) {
    if (n == 1) {
      return res;
    }
    res = n * res;
    n = n - 1;
  }
}

void main() {
  printf(" %d", faculty(4));
}
