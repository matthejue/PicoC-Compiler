  // ---------------------------- Logic expressions ---------------------------
  printf(" %d", (var * 2 == 'A' - 1) * 42);
  printf(" %d", !0 * 42);
  or_exp_true = 0 || var == 0 || !var + 1;
  or_exp_false = 0 || 0 + !'A' || !var;
