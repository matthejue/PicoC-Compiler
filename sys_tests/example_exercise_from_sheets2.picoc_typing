_global_inits:
main:
  StackMalloc('3')
  Exp(Alloc(Writeable(), IntType(), Name('x'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('y'), 'local_var'), Empty())
  Assign(Alloc(Const(), IntType(), Name('z'), 'local_var'), Num('2'))
  Assign(Stackframe(Num('1'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  // While(Atom(Name('x'), GtE(), BinOp(Name('z'), Mul(), Name('y'))), [Assign(Name('x'), BinOp(Name('x'), Sub(), Num('3')))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      GtE(), 
      BinOp(
        Num('2'), 
        Mul(), 
        Stackframe(
          Num('1'), 
          IntType()))), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Assign(Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('3')))
  GoTo(Name('condition_check.2'))
while_after.0:
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Return(Empty())