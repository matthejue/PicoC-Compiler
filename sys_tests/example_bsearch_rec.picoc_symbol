_global_inits:
  Assign(Global(Name('ar'), ArrayDecl(Num('10'), IntType())), Array([Num('1'), Num('3'), Num('4'), Num('7'), Num('19'), Num('42'), Num('128'), Num('314'), Num('512'), Num('1024')], Empty()))
  Assign(Global(Name('ar_with_len'), StructSpec(Name('ar_with_lent'))), Struct([Assign(Name('len'), Num('10')), Assign(Name('ar'), Global(Name('ar'), ArrayDecl(Num('10'), IntType())))], Empty()))
bsearch_rec:
  StackMalloc('1')
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('ar'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('key'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('lo'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('hi'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('m'), 'local_var'), Empty())
  // If(Atom(Name('lo'), Eq(), Name('hi')), [Return(Num('-1'))]), 
  IfElse(
    Atom(
      Stackframe(
        Num('2'), 
        IntType()), 
      Eq(), 
      Stackframe(
        Num('3'), 
        IntType())), 
    [
      GoTo(Name('if.7'))
    ], 
    [
      GoTo(Name('if_else_after.6'))
    ])
if.7:
  Return(Num('-1'))
if_else_after.6:
  Assign(Stackframe(Num('4'), IntType()), BinOp(BinOp(Stackframe(Num('2'), IntType()), Add(), Stackframe(Num('3'), IntType())), Div(), Num('2')))
  // Return(Name('m')), 
  IfElse(
    Atom(
      Deref(
        Stackframe(
          Num('0'), 
          PntrDecl(
            IntType())), 
        Stackframe(
          Num('4'), 
          IntType()), 
        Empty()), 
      Eq(), 
      Stackframe(
        Num('1'), 
        IntType())), 
    [
      GoTo(Name('if.5'))
    ], 
    [
      GoTo(Name('else.4'))
    ])
if.5:
  Return(Stackframe(Num('4'), IntType()))
else.4:
  // Return(Call(Name('bsearch_rec'), [Name('ar'), Name('key'), Name('lo'), Name('m')])), 
  IfElse(
    Atom(
      Deref(
        Stackframe(
          Num('0'), 
          PntrDecl(
            IntType())), 
        Stackframe(
          Num('4'), 
          IntType()), 
        Empty()), 
      Gt(), 
      Stackframe(
        Num('1'), 
        IntType())), 
    [
      GoTo(Name('if.3'))
    ], 
    [
      GoTo(Name('else.2'))
    ])
if.3:
  Return(Call(Name('bsearch_rec'), [Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('1'), IntType()), Stackframe(Num('2'), IntType()), Stackframe(Num('4'), IntType())]))
else.2:
  Return(Call(Name('bsearch_rec'), [Stackframe(Num('0'), PntrDecl(IntType())), Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('4'), IntType()), Add(), Num('1')), Stackframe(Num('3'), IntType())]))
if_else_after.1:
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Return(Empty())
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('bsearch_rec'), [Attr(Global(Name('ar_with_len'), StructSpec(Name('ar_with_lent'))), Name('ar'), Empty()), Call(Name('input'), []), Num('0'), BinOp(Attr(Global(Name('ar_with_len'), StructSpec(Name('ar_with_lent'))), Name('len'), Empty()), Sub(), Num('1'))])]), Empty())
  Exp(Call(Name('print'), [Call(Name('bsearch_rec'), [Attr(Global(Name('ar_with_len'), StructSpec(Name('ar_with_lent'))), Name('ar'), Empty()), Call(Name('input'), []), Num('0'), BinOp(Attr(Global(Name('ar_with_len'), StructSpec(Name('ar_with_lent'))), Name('len'), Empty()), Sub(), Num('1'))])]), Empty())
  Return(Empty())