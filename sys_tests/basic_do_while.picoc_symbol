_global_inits:
main:
  StackMalloc('3')
  Assign(Alloc(Const(), IntType(), Name('min'), 'local_var'), Num('6'))
  Assign(Alloc(Const(), IntType(), Name('max'), 'local_var'), Num('42'))
  Assign(Stackframe(Num('2'), IntType()), Num('6'))
  // DoWhile(BinOp(Atom(Name('i'), Gt(), Name('min')), LogicAnd(), Atom(Name('i'), Lt(), Name('max'))), [Assign(Name('i'), BinOp(Name('i'), Add(), Call(Name('input'), [])))])
  GoTo(Name('do_while_branch.1'))
do_while_branch.1:
  Assign(Stackframe(Num('2'), IntType()), BinOp(Stackframe(Num('2'), IntType()), Add(), Call(Name('input'), []))), 
  IfElse(
    BinOp(
      Atom(
        Stackframe(
          Num('2'), 
          IntType()), 
        Gt(), 
        Num('6')), 
      LogicAnd(), 
      Atom(
        Stackframe(
          Num('2'), 
          IntType()), 
        Lt(), 
        Num('42'))), 
    [
      GoTo(Name('do_while_branch.1'))
    ], 
    [
      GoTo(Name('do_while_after.0'))
    ])
do_while_after.0:
  Exp(Call(Name('print'), [Stackframe(Num('2'), IntType())]), Empty())
  Return(Empty())