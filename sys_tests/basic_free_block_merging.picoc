#include "./include/simple_malloc.h"

int main() {
    init_heap();

    int *a = (int *)simple_malloc(4);
    int *b = (int *)simple_malloc(4);
    int *c = (int *)simple_malloc(3);

    c[0] = 3;
    c[2] = 4;

    simple_free(a);
    simple_free(b);

    int *d = (int *)simple_malloc(11);
    d[0] = 21;
    d[10] = 2;

    print(c[0] * c[5]);
    print(d[0] * d[10]);

    return 0;
}
