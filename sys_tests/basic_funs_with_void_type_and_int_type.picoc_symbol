_global_inits:
void_fun:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('param'), 'param'), Empty())
  Assign(Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Add(), Num('2')))
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Return(Empty())
int_fun:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('param'), 'param'), Empty())
  Return(BinOp(Stackframe(Num('0'), IntType()), Add(), Num('2')))
main:
  StackMalloc('1')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Exp(Call(Name('void_fun'), [Stackframe(Num('0'), IntType())]), Empty())
  Exp(Call(Name('print'), [Call(Name('int_fun'), [Stackframe(Num('0'), IntType())])]), Empty())
  Return(Empty())