  Assign(Stackframe(Num('0'), PntrDecl(IntType())), BinOp(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Add(), BinOp(Num('1'), Add(), Num('1'))))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType()))]), Empty())
  Assign(Stackframe(Num('0'), PntrDecl(IntType())), BinOp(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Add(), BinOp(Num('1'), Add(), Num('1'))))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType()))]), Empty())
  Assign(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Ref(Attr(Stackframe(Num('7'), StructSpec(Name('array_with_len'))), Name('ar'), StructSpec(Name('array_with_len'))), PntrDecl(IntType())))
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Num('0'), PntrDecl(PntrDecl(IntType()))), BinOp(Attr(Stackframe(Num('7'), StructSpec(Name('array_with_len'))), Name('len'), StructSpec(Name('array_with_len'))), Sub(), Num('1')), PntrDecl(IntType()))]), Empty())
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Num('0'), PntrDecl(PntrDecl(IntType()))), Num('2'), PntrDecl(IntType()))]), Empty())
  Assign(Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), PntrDecl(IntType())), BinOp(Stackframe(Num('2'), IntType()), Mul(), Num('2')))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Num('2'), ArrayDecl(Num('3'), IntType()))]), Empty())
