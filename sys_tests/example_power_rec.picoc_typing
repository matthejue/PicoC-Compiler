_global_inits:
power:
  StackMalloc('0')
  Exp(Alloc(Writeable(), IntType(), Name('a'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('n'), 'param'), Empty())
  // Return(Num('1')), 
  IfElse(
    Atom(
      Stackframe(
        Num('1'), 
        IntType()), 
      Eq(), 
      Num('0')), 
    [
      GoTo(Name('if.2'))
    ], 
    [
      GoTo(Name('else.1'))
    ])
if.2:
  Return(Num('1'))
else.1:
  Return(BinOp(Stackframe(Num('0'), IntType()), Mul(), Call(Name('power'), [Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('1'), IntType()), Sub(), Num('1'))])))
if_else_after.0:
  Return(Empty())
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('power'), [Call(Name('input'), []), Call(Name('input'), [])])]), Empty())
  Return(Empty())