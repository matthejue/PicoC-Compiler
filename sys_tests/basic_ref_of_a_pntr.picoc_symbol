_global_inits:
main:
  StackMalloc('3')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('1'), PntrDecl(IntType())), Ref(Stackframe(Num('0'), IntType()), Empty()))
  Assign(Stackframe(Num('2'), PntrDecl(PntrDecl(IntType()))), Ref(Stackframe(Num('1'), PntrDecl(IntType())), Empty()))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('1'), PntrDecl(IntType())), Num('0'), Empty())]), Empty())
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('2'), PntrDecl(PntrDecl(IntType()))), Num('0'), Empty()), Num('0'), Empty())]), Empty())
  Return(Empty())