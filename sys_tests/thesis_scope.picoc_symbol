_global_inits:
fun_scope:
  StackMalloc('1')
  Exp(Alloc(Writeable(), IntType(), Name('param'), 'param'), Empty())
  Assign(Stackframe(Num('1'), IntType()), Num('2'))
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Return(Empty())
main:
  StackMalloc('1')
  Assign(Stackframe(Num('0'), IntType()), Num('4'))
  Exp(Call(Name('fun_scope'), [Stackframe(Num('0'), IntType())]), Empty())
  Return(Empty())