_global_inits:
main:
  StackMalloc('2')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('1'), IntType()), Num('1'))
  // While(Atom(Name('n'), NEq(), Num('1')), [Assign(Name('res'), BinOp(Name('n'), Mul(), Name('res'))), Assign(Name('n'), BinOp(Name('n'), Sub(), Num('1')))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      NEq(), 
      Num('1')), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Mul(), Stackframe(Num('1'), IntType())))
  Assign(Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('1')))
  GoTo(Name('condition_check.2'))
while_after.0:
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Return(Empty())