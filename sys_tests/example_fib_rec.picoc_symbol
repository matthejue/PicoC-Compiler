_global_inits:
fib:
  StackMalloc('3')
  Exp(Alloc(Writeable(), IntType(), Name('n'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('res_f'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('a'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('b'), 'local_var'), Empty())
  // Assign(Name('res_f'), Num('0')), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Eq(), 
      Num('0')), 
    [
      GoTo(Name('if.5'))
    ], 
    [
      GoTo(Name('else.4'))
    ])
if.5:
  Assign(Stackframe(Num('1'), IntType()), Num('0'))
  GoTo(Name('if_else_after.0'))
else.4:
  // Assign(Name('res_f'), Num('1')), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Eq(), 
      Num('1')), 
    [
      GoTo(Name('if.3'))
    ], 
    [
      GoTo(Name('else.2'))
    ])
if.3:
  Assign(Stackframe(Num('1'), IntType()), Num('1'))
  GoTo(Name('if_else_after.1'))
else.2:
  Assign(Stackframe(Num('2'), IntType()), Call(Name('fib'), [BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('1'))]))
  Assign(Stackframe(Num('3'), IntType()), Call(Name('fib'), [BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('2'))]))
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('2'), IntType()), Add(), Stackframe(Num('3'), IntType())))
  GoTo(Name('if_else_after.1'))
if_else_after.1:
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Return(Stackframe(Num('1'), IntType()))
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('fib'), [Call(Name('input'), [])])]), Empty())
  Return(Empty())