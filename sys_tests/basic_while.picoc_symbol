_global_inits:
main:
  StackMalloc('2')
  Assign(Alloc(Const(), IntType(), Name('max'), 'local_var'), Num('42'))
  Assign(Stackframe(Num('1'), IntType()), Num('6'))
  // While(Atom(Name('i'), Lt(), Name('max')), [Assign(Name('i'), BinOp(Name('i'), Add(), Call(Name('input'), [])))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('1'), 
        IntType()), 
      Lt(), 
      Num('42')), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('1'), IntType()), Add(), Call(Name('input'), [])))
  GoTo(Name('condition_check.2'))
while_after.0:
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Return(Empty())