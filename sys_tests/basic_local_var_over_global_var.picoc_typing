_global_inits:
  Assign(Global(Name('var'), IntType()), Call(Name('input'), []))
fun_with_local_var:
  StackMalloc('1')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Return(Empty())
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Global(Name('var'), IntType())]), Empty())
  Exp(Call(Name('fun_with_local_var'), []), Empty())
  Return(Empty())