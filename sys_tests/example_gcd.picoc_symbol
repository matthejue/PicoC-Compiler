_global_inits:
gcd:
  StackMalloc('1')
  Exp(Alloc(Writeable(), IntType(), Name('a'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('b'), 'param'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('c'), 'local_var'), Empty())
  // While(Atom(Name('b'), NEq(), Num('0')), [Assign(Name('c'), BinOp(Name('a'), Mod(), Name('b'))), Assign(Name('a'), Name('b')), Assign(Name('b'), Name('c'))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('1'), 
        IntType()), 
      NEq(), 
      Num('0')), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Assign(Stackframe(Num('2'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Mod(), Stackframe(Num('1'), IntType())))
  Assign(Stackframe(Num('0'), IntType()), Stackframe(Num('1'), IntType()))
  Assign(Stackframe(Num('1'), IntType()), Stackframe(Num('2'), IntType()))
  GoTo(Name('condition_check.2'))
while_after.0:
  Return(Stackframe(Num('0'), IntType()))
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('gcd'), [Call(Name('input'), []), Call(Name('input'), [])])]), Empty())
  Exp(Call(Name('print'), [Call(Name('gcd'), [Call(Name('input'), []), Call(Name('input'), [])])]), Empty())
  Return(Empty())