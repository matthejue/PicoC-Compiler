int sum(int count, ...);

int sum(int count, ...) {
  debug;
  int total = 0;
  int *arg = &count - 1;
  debug;

  while (count) {
    total = total + *arg;
    arg = arg - 1;
    count = count - 1;
  }

  debug;
  return total;
}

void main() {
  debug;
  print(sum(3, 10, 20, 30));
}
