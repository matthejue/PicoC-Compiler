_global_inits:
main:
  StackMalloc('5')
  Exp(Alloc(Writeable(), IntType(), Name('or_exp_true'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('or_exp_false'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('and_exp_true'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), IntType(), Name('and_exp_false'), 'local_var'), Empty())
  Assign(Stackframe(Num('4'), IntType()), Call(Name('input'), []))
  Exp(Call(Name('print'), [BinOp(BinOp(Stackframe(Num('4'), IntType()), Add(), Char('n')), Sub(), Num('100'))]), Empty())
  Exp(Call(Name('print'), [UnOp(Minus(), BinOp(UnOp(Minus(), Char('*')), Add(), BinOp(Stackframe(Num('4'), IntType()), Mul(), Num('0'))))]), Empty())
  Exp(Call(Name('print'), [BinOp(BinOp(UnOp(Minus(), BinOp(Char(' '), Add(), UnOp(Minus(), Stackframe(Num('4'), IntType())))), Mul(), Char('*')), Add(), Char('*'))]), Empty())
  Exp(Call(Name('print'), [BinOp(Atom(BinOp(Stackframe(Num('4'), IntType()), Mul(), Num('2')), Eq(), BinOp(Char('A'), Sub(), Num('1'))), Mul(), Num('42'))]), Empty())
  Exp(Call(Name('print'), [BinOp(UnOp(LogicNot(), ToBool(Num('0'))), Mul(), Num('42'))]), Empty())
  Assign(Stackframe(Num('0'), IntType()), BinOp(BinOp(ToBool(Num('0')), LogicOr(), Atom(Stackframe(Num('4'), IntType()), Eq(), Num('0'))), LogicOr(), ToBool(BinOp(UnOp(LogicNot(), ToBool(Stackframe(Num('4'), IntType()))), Add(), Num('1')))))
  Assign(Stackframe(Num('1'), IntType()), BinOp(BinOp(ToBool(Num('0')), LogicOr(), ToBool(BinOp(Num('0'), Add(), UnOp(LogicNot(), ToBool(Char('A')))))), LogicOr(), UnOp(LogicNot(), ToBool(Stackframe(Num('4'), IntType())))))
  Assign(Stackframe(Num('2'), IntType()), BinOp(BinOp(ToBool(Num('1')), LogicAnd(), UnOp(LogicNot(), ToBool(BinOp(Stackframe(Num('4'), IntType()), Sub(), Stackframe(Num('4'), IntType()))))), LogicAnd(), Atom(Stackframe(Num('4'), IntType()), NEq(), Num('0'))))
  Assign(Stackframe(Num('3'), IntType()), BinOp(BinOp(ToBool(Num('1')), LogicAnd(), ToBool(Stackframe(Num('4'), IntType()))), LogicAnd(), UnOp(LogicNot(), ToBool(Stackframe(Num('4'), IntType())))))
  Exp(Call(Name('print'), [Stackframe(Num('0'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('1'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('2'), IntType())]), Empty())
  Exp(Call(Name('print'), [Stackframe(Num('3'), IntType())]), Empty())
  Exp(Call(Name('print'), [BinOp(BinOp(ToBool(Stackframe(Num('2'), IntType())), LogicAnd(), ToBool(BinOp(Stackframe(Num('3'), IntType()), Add(), Num('1')))), Add(), BinOp(Num('41'), Mul(), BinOp(ToBool(Stackframe(Num('0'), IntType())), LogicOr(), ToBool(Stackframe(Num('1'), IntType())))))]), Empty())
  Return(Empty())