translation_unit: int fast_efficient_iterative(int a, int n, int acc) {\n  int tmp;\n  while (n != 0) {\n    if (n % 2 == 0) {\n      a = a * a;\n      n = n / 2;\n    } else {\n      tmp = a;\n      a = a * a;\n      n = n / 2;\n      acc = acc * tmp;\n    }\n  }\n  return acc;\n}\n\nvoid main() {\n  print(fast_efficient_iterative(input(), input(), 1));\n}\n
