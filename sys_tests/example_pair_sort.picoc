// in:10 5
// expected: 10 5 1 5 10
// from the Operating Systems Lecture by Prof. Dr. Christoph Scholl
// dependencies: ../../Pico-OS/lib/stdio/stdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"


int pairsort(int *x, int *y) {
  int h;
  int getauscht = 0;
  if (*x > *y) {
    h = *x; *x = *y; *y = h; getauscht = 1;
  }
  return getauscht;
}

void main() {
  int res;
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int a = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int b = __picoc_input_1;
  printf(" %d", a);
  printf(" %d", b);
  res = pairsort(&a, &b);
  printf(" %d", res);
  printf(" %d", a);
  printf(" %d", b);
}
