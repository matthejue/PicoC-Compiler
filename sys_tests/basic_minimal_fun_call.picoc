// in:
// expected: 42
// dependencies: ../../Pico-OS/lib/stdio/stdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

int add_one_if_larger_40(int value) {
  if (value > 40) {
    return value + 1;
  } else {
    return value;
  }
}

void main() {
  int result = add_one_if_larger_40(41);
  printf(" %d", result);
}
