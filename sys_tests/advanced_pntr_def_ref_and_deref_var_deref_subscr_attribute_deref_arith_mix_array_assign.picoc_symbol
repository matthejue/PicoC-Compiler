_global_inits:
main:
  StackMalloc('8')
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('pntr_on_int'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(PntrDecl(IntType())), Name('pntr_on_pntr'), 'local_var'), Empty())
  Assign(Stackframe(Num('2'), IntType()), Call(Name('input'), []))
  Assign(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Array([Num('4'), Num('2'), Call(Name('input'), [])], Empty()))
  Assign(Stackframe(Num('7'), StructSpec(Name('array_with_len'))), Struct([Assign(Name('ar'), Stackframe(Num('5'), ArrayDecl(Num('3'), IntType()))), Assign(Name('len'), Num('3'))], Empty()))
  Assign(Stackframe(Num('0'), PntrDecl(IntType())), Ref(Stackframe(Num('2'), IntType()), Empty()))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty())]), Empty())
  Assign(Stackframe(Num('0'), PntrDecl(IntType())), BinOp(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Add(), BinOp(Num('1'), Add(), Num('1'))))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty())]), Empty())
  Assign(Stackframe(Num('0'), PntrDecl(IntType())), BinOp(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Add(), BinOp(Num('1'), Add(), Num('1'))))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty())]), Empty())
  Assign(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Ref(Attr(Stackframe(Num('7'), StructSpec(Name('array_with_len'))), Name('ar'), Empty()), Empty()))
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Num('0'), Empty()), BinOp(Attr(Stackframe(Num('7'), StructSpec(Name('array_with_len'))), Name('len'), Empty()), Sub(), Num('1')), Empty())]), Empty())
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('1'), PntrDecl(PntrDecl(IntType()))), Num('0'), Empty()), Num('2'), Empty())]), Empty())
  Assign(Deref(Stackframe(Num('0'), PntrDecl(IntType())), Num('0'), Empty()), BinOp(Stackframe(Num('2'), IntType()), Mul(), Num('2')))
  Exp(Call(Name('print'), [Deref(Stackframe(Num('5'), ArrayDecl(Num('3'), IntType())), Num('2'), Empty())]), Empty())
  Return(Empty())