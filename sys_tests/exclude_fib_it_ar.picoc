  scanf(" %d", &__picoc_input_0);
  int num_fibs = __picoc_input_0;
  int *pntr = &num_fibs;
  int *ar = &*(pntr + 3);
  ar[0] = 1;
  ar[1] = 1;
  printf(" %d", fib(num_fibs, ar));
}
