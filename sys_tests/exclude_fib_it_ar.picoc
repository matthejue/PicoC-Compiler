#include "../../Pico-OS/lib/stdio/stdio.header"

int fib(int num_fibs, int *ar) {
  int i = 2;
  while (i < num_fibs) {
    ar[i] = ar[i - 1] + ar[i - 2];
    i = i + 1;
  }
  return ar[num_fibs - 1];
}

