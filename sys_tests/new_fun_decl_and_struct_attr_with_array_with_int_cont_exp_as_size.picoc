// in:41
// expected:42

#define SIZE (8 * 4)

/* struct with array attribute */
struct Box {
    int data[SIZE];
};

/* function using last element of array */
int last_element(int arr[SIZE]) {
    return arr[SIZE - 1];
}

int main() {
    debug;
    struct Box b;

    int x = input();
    debug;
    b.data[SIZE - 1] = x + 1;
    debug;

    print(last_element(b.data));
    debug;

    return 0;
}
