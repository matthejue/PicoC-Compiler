// in:
// expected: 42
// dependencies: ../../Pico-OS/lib/stdio/libstdio.picoc
#include "../../Pico-OS/lib/stdio/stdio.header"

struct st1 {int *attr[2];};

struct st2 {int attr1; struct st1 attr2;};

void main() {
  int var = 42;
  struct st2 st = {.attr1=var, .attr2={.attr={&var, &var}}};
  printf(" %d", *st.attr2.attr[1]);
}
