translation_unit: int power_efficient(int a, int n) {\n  if (n == 0) {\n    return 1;\n  } else if (n % 2 == 0) {\n    return power_efficient(a * a, n / 2);\n  } else {\n    return a * power_efficient(a * a, n / 2);\n  }\n}\n\nvoid main() {\n  print(power_efficient(input(), input()));\n}\n
