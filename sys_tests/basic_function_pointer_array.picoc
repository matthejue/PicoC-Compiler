// in:
// expected: 7 7 3
// dependencies: ../../Pico-OS/lib/stdio/libstdio.reti_blocks
#include "../../Pico-OS/lib/stdio/stdio.header"

int add(int left, int right) {
  return left + right;
}

int sub(int left, int right) {
  return left - right;
}

void main() {
  int (*fp)(int, int);
  int (*ops[2])(int, int);

  fp = add;
  ops[0] = add;
  ops[1] = sub;

  printf(" %d", fp(3, 4));
  printf(" %d", ops[0](3, 4));
  printf(" %d", ops[1](7, 4));
}
