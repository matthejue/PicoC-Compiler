_global_inits:
faculty:
  StackMalloc('1')
  Exp(Alloc(Writeable(), IntType(), Name('n'), 'param'), Empty())
  Assign(Stackframe(Num('1'), IntType()), Num('1'))
  // While(Num('1'), [If(Atom(Name('n'), Eq(), Num('1')), [Return(Name('res'))]), Assign(Name('res'), BinOp(Name('n'), Mul(), Name('res'))), Assign(Name('n'), BinOp(Name('n'), Sub(), Num('1')))])
  GoTo(Name('condition_check.4'))
condition_check.4:
  IfElse(
    Num('1'), 
    [
      GoTo(Name('while_branch.3'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.3:
  // If(Atom(Name('n'), Eq(), Num('1')), [Return(Name('res'))]), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Eq(), 
      Num('1')), 
    [
      GoTo(Name('if.2'))
    ], 
    [
      GoTo(Name('if_else_after.1'))
    ])
if.2:
  Return(Stackframe(Num('1'), IntType()))
if_else_after.1:
  Assign(Stackframe(Num('1'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Mul(), Stackframe(Num('1'), IntType())))
  Assign(Stackframe(Num('0'), IntType()), BinOp(Stackframe(Num('0'), IntType()), Sub(), Num('1')))
  GoTo(Name('condition_check.4'))
while_after.0:
  Return(Empty())
main:
  StackMalloc('0')
  Exp(Call(Name('print'), [Call(Name('faculty'), [Num('4')])]), Empty())
  Return(Empty())