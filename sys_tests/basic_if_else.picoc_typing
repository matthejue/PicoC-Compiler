_global_inits:
main:
  StackMalloc('1')
  Assign(Stackframe(Num('0'), IntType()), Call(Name('input'), []))
  // Exp(Call(Name('print'), [Num('42')]), Empty()), 
  IfElse(
    Atom(
      Stackframe(
        Num('0'), 
        IntType()), 
      Lt(), 
      Num('10')), 
    [
      GoTo(Name('if.5'))
    ], 
    [
      GoTo(Name('else.4'))
    ])
if.5:
  Exp(Call(Name('print'), [Num('42')]), Empty())
  GoTo(Name('if_else_after.3'))
else.4:
  GoTo(Name('if_else_after.3'))
if_else_after.3:
  // Exp(Call(Name('print'), [Num('42')]), Empty()), 
  IfElse(
    BinOp(
      Atom(
        Stackframe(
          Num('0'), 
          IntType()), 
        NEq(), 
        Num('10')), 
      LogicAnd(), 
      Atom(
        Stackframe(
          Num('0'), 
          IntType()), 
        Eq(), 
        Num('10'))), 
    [
      GoTo(Name('if.2'))
    ], 
    [
      GoTo(Name('else.1'))
    ])
if.2:
  GoTo(Name('if_else_after.0'))
else.1:
  Exp(Call(Name('print'), [Num('42')]), Empty())
  GoTo(Name('if_else_after.0'))
if_else_after.0:
  Return(Empty())