#define SIZE (3 * 2)

/* struct with array attribute */
struct Box {
    int data[SIZE];
};

/* function using last element of array */
int last_element(int arr[SIZE]) {
    int var = 2;
    return arr[SIZE - 1];
}

int main() {
    struct Box b;

    int x = input();
    b.data[SIZE - 1] = x + 1;

    debug;
    print(last_element(b.data));

    return 0;
}
