  Assign(Stackframe(Num('1'), PntrDecl(ArrayDecl(Num('3'), IntType()))), Ref(Stackframe(Num('4'), ArrayDecl(Num('3'), IntType())), ArrayDecl(Num('3'), IntType())))
  Exp(Call(Name('print'), [Deref(Deref(Stackframe(Num('1'), PntrDecl(ArrayDecl(Num('3'), IntType()))), Num('0'), PntrDecl(ArrayDecl(Num('3'), IntType()))), Num('1'), ArrayDecl(Num('3'), IntType()))]), Empty())
  Return(Empty())