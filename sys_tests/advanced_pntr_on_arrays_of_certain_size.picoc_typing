_global_inits:
main:
  StackMalloc('5')
  Exp(Alloc(Writeable(), PntrDecl(IntType()), Name('pntr_on_int'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), PntrDecl(ArrayDecl(Num('3'), IntType())), Name('pntr_on_array'), 'local_var'), Empty())
