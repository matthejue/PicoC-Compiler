_global_inits:
  Exp(Alloc(Writeable(), IntType(), Name('i'), 'local_var'), Empty())
  Exp(Alloc(Writeable(), StructSpec(Name('st')), Name('global_st'), 'local_var'), Empty())
print_ar:
  StackMalloc('1')
  Exp(Alloc(Writeable(), StructSpec(Name('st')), Name('param_st'), 'param'), Empty())
  Assign(Stackframe(Num('3'), IntType()), Num('0'))
  // While(Atom(Name('i'), Lt(), Attr(Name('param_st'), Name('len'), Empty())), [Exp(Call(Name('print'), [Deref(Attr(Name('param_st'), Name('ar'), Empty()), Name('i'), Empty())]), Empty()), Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.2'))
condition_check.2:
  IfElse(
    Atom(
      Stackframe(
        Num('3'), 
        IntType()), 
      Lt(), 
      Attr(
        Stackframe(
          Num('2'), 
          StructSpec(
            Name('st'))), 
        Name('len'), 
        StructSpec(
          Name('st')))), 
    [
      GoTo(Name('while_branch.1'))
    ], 
    [
      GoTo(Name('while_after.0'))
    ])
while_branch.1:
  Exp(Call(Name('print'), [Deref(Attr(Stackframe(Num('2'), StructSpec(Name('st'))), Name('ar'), StructSpec(Name('st'))), Stackframe(Num('3'), IntType()), ArrayDecl(Num('2'), IntType()))]), Empty())
  Assign(Stackframe(Num('3'), IntType()), BinOp(Stackframe(Num('3'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.2'))
while_after.0:
  Return(Empty())
main:
  StackMalloc('2')
  Assign(Stackframe(Num('1'), ArrayDecl(Num('2'), IntType())), Array([Num('42'), Num('314')], Empty()))
  Assign(Global(Name('i'), IntType()), Num('0'))
  // While(Atom(Name('i'), Lt(), Num('2')), [Assign(Deref(Attr(Name('global_st'), Name('ar'), Empty()), Name('i'), Empty()), Deref(Name('ar'), Name('i'), Empty())), Assign(Name('i'), BinOp(Name('i'), Add(), Num('1')))])
  GoTo(Name('condition_check.6'))
condition_check.6:
  IfElse(
    Atom(
      Global(
        Name('i'), 
        IntType()), 
      Lt(), 
      Num('2')), 
    [
      GoTo(Name('while_branch.5'))
    ], 
    [
      GoTo(Name('while_after.4'))
    ])
while_branch.5:
  Assign(Deref(Attr(Global(Name('global_st'), StructSpec(Name('st'))), Name('ar'), StructSpec(Name('st'))), Global(Name('i'), IntType()), ArrayDecl(Num('2'), IntType())), Deref(Stackframe(Num('1'), ArrayDecl(Num('2'), IntType())), Global(Name('i'), IntType()), ArrayDecl(Num('2'), IntType())))
  Assign(Global(Name('i'), IntType()), BinOp(Global(Name('i'), IntType()), Add(), Num('1')))
  GoTo(Name('condition_check.6'))
while_after.4:
  Assign(Attr(Global(Name('global_st'), StructSpec(Name('st'))), Name('len'), StructSpec(Name('st'))), Global(Name('i'), IntType()))
  Exp(Call(Name('print_ar'), [Global(Name('global_st'), StructSpec(Name('st')))]), Empty())
  Return(Empty())