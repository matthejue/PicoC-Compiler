// in:
// expected:-2 314

struct stt {int len; int *ar;};

int ar[6] = {314, 42, 4, 42, -2, 5};

struct stt st_ar = {.len=6, .ar=ar};

int swap(int *x, int *y) {
  int h;
  int swapped = 0;
  if (*x > *y) {
    h = *x; *x = *y; *y = h; swapped = 1;
  }
  return swapped;
}

void main() {
  swapped = swap(&st_ar.ar[2], &st_ar.ar[3]);
  print(st_ar.ar[2]);
  print(st_ar.ar[3]);
}
