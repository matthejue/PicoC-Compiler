// in:
// expected:4 42 -2 42

struct stt {int len; int *ar;};

int ar[6] = {314, 42, 4, 42, -2, 5};

struct stt st_ar = {.len=6, .ar=ar};

int swap(int *x, int *y) {
  int h;
  if (*x > *y) {
    h = *x; *x = *y; *y = h;
  }
}

void main() {
  swap(&st_ar.ar[2], &st_ar.ar[3]);
  print(st_ar.ar[2]);
  print(st_ar.ar[3]);
  swap(&st_ar.ar[3], &st_ar.ar[4]);
  print(st_ar.ar[3]);
  print(st_ar.ar[4]);
}
