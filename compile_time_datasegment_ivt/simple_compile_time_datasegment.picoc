// in:
// expected:3 5 7 11 22 1 2 1 2
int first_value();

int second_value();

__attribute__((section("interrupt_vector_table")))
int numbers[3] = {3, 5, 7};
__attribute__((section("interrupt_vector_table")))
int (*operations[2])() = {first_value, second_value};

struct pair {
  int values[2];
  int (*left)();
  int (*right)();
};

__attribute__((section("interrupt_vector_table")))
struct pair data = {.values = {11, 22}, .left = first_value, .right = second_value};

__attribute__((section("interrupt_vector_table")))
int first_value() {
  return 1;
}

__attribute__((section("interrupt_vector_table")))
int second_value() {
  return 2;
}

void main() {
  print(numbers[0]);
  print(numbers[1]);
  print(numbers[2]);
  print(data.values[0]);
  print(data.values[1]);
  print(operations[0]());
  print(operations[1]());
  print(data.left());
  print(data.right());
}
