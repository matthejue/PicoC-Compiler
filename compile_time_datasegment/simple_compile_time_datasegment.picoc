// in:
// expected:3 5 7 11 22 1 2 1 2

int first_value() {
  return 1;
}

int second_value() {
  return 2;
}

int numbers[3] = {3, 5, 7};
int (*operations[2])() = {first_value, second_value};

struct pair {
  int values[2];
  int (*left)();
  int (*right)();
};

struct pair data = {.values = {11, 22}, .left = first_value, .right = second_value};

void main() {
  print(numbers[0]);
  print(numbers[1]);
  print(numbers[2]);
  print(data.values[0]);
  print(data.values[1]);
  print(operations[0]());
  print(operations[1]());
  print(data.left());
  print(data.right());
}