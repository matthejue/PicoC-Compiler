// in:
// expected: 42 2 2
// dependencies: ../../Pico-OS/library/stdio/libstdio.reti_blocks
#include "../../Pico-OS/library/stdio/stdio.header"

struct Point {
    int x;
    int y;
};

int main() {
    int a = 42;
    struct Point p = {10, 20};

    printf(" %d", sizeof(a) + 41);
    printf(" %d", sizeof(p));
    printf(" %d", sizeof(struct Point));

    return 0;
}
