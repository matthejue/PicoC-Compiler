#include "../../Pico-OS/library/stdio/stdio.header"


int power(int a, int n) {
  if (n == 0) {
    return 1;
  } else {
    return a * power(a, n - 1);
  }
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int a = __picoc_input_0;
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int n = __picoc_input_1;
  printf(" %d", power(a, n));
}
