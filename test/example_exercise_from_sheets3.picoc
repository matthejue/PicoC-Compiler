  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  int y = __picoc_input_1;
  printf(" %d", is_less_equal_without_overflow(x, y));
  int __picoc_input_2;
  scanf(" %d", &__picoc_input_2);
  x = __picoc_input_2;
  int __picoc_input_3;
  scanf(" %d", &__picoc_input_3);
  y = __picoc_input_3;
  printf(" %d", is_less_equal_without_overflow(x, y));
  int __picoc_input_4;
