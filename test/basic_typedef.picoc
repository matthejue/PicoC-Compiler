// in:
// expected: 42
// dependencies: ../../Pico-OS/library/stdio/libstdio.reti_blocks
#include "../../Pico-OS/library/stdio/stdio.header"

typedef int bool;

struct Result {
  bool value;
};

bool identity(bool value) {
  bool copy = value;
  return copy;
}

void main() {
  struct Result result = {.value=identity(42)};
  printf(" %d", result.value);
}
