#include "../../Pico-OS/library/stdio/stdio.header"

struct st {int attr1; int attr2[2];};


void fun_struct_from_stackframe(struct st param) {
  printf(" %d", param.attr2[1]);
}

void fun_struct_from_global_data(struct st param) {
  printf(" %d", param.attr2[1]);
