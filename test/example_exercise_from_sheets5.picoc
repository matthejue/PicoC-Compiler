// in:1
// expected: 4 7
// from the Operating Systems Lecture by Prof. Dr. Christoph Scholl
// dependencies: ../../Pico-OS/library/stdio/libstdio.reti_blocks
#include "../../Pico-OS/library/stdio/stdio.header"

void main() {
  int f[3][4]; //zweidimensionales Feld f
  int g;
  // ...
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  g = __picoc_input_0;
  // ...
  /** Zugriff mit arithmetischen Ausdruecken **/
  f[1 + g][2] = 4;
  printf(" %d", f[1 + g][2]);
  g = 3 + f[2][1 + g];
  printf(" %d", g);
}
