// dependencies: ../../Pico-OS/library/stdio/libstdio.reti_blocks
#include "../../Pico-OS/library/stdio/stdio.header"

struct ar_with_lent {int len; int *ar;};

int ar[10] = {1, 3, 4, 7, 19, 42, 128, 314, 512, 1024};

struct ar_with_lent ar_with_len = {.len=10, .ar=ar};

int bsearch_it(struct ar_with_lent ar_with_len, int key) {
    int lo = 0;
    int hi = ar_with_len.len;
    int m;
    while (lo != hi) {
        m = (lo + hi) / 2;
        if (ar_with_len.ar[m] == key)
            return m;
        else if (ar_with_len.ar[m] > key)
            hi = m;  // bsearch_rec(ar, key, lo, m)
        else  // ar_with_len.ar[m] < key
            lo = m+1;  // bsearch_rec(ar, key, m+1, hi)
    }
    return -1;
}

void main() {
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  printf(" %d", bsearch_it(ar_with_len, __picoc_input_0));
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  printf(" %d", bsearch_it(ar_with_len, __picoc_input_1));
}
