#include "../../Pico-OS/library/stdio/stdio.header"

int b;
int x;

int ps(int *x, int *y) {
  int h;
  int getauscht;
  getauscht = 0;
  if (*x > *y) {
    h = *x; *x = *y;
    *y = h; getauscht = 1;
  }
  return getauscht;
}
void main() {
  int b; int res;
  int __picoc_input_0;
  scanf(" %d", &__picoc_input_0);
  int __picoc_input_1;
  scanf(" %d", &__picoc_input_1);
  x = __picoc_input_0; b = __picoc_input_1;
  printf(" %d", x);
  printf(" %d", b);
  res = ps(&x, &b);
  printf(" %d", res);
  printf(" %d", x);
  printf(" %d", b);
}
